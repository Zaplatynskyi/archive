# Скопіюйте у .env та відредагуйте за потреби.

# Тека з архівом (68 річних тек + «Заочна форма» з Excel-описами).
ARCHIVE_ROOT=../../../Архів випускників

# Файл бази даних SQLite.
DB_PATH=data/alumni.db

# Секретний ключ Flask (обов'язково змініть для продакшену).
SECRET_KEY=change-me-to-a-random-string

FACULTY_NAME=Факультет механіки, енергетики та інформаційних технологій
PAGE_SIZE=40
